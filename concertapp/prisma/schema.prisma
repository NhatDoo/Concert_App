generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  
}

model User {
  id           String    @id @default(uuid())
  name         String
  phoneNumber  String?
  email        String    @unique
  password     String
  role         String
  provider     String    @default("LOCAL")
  googleId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  refreshToken String?
  bookings     Booking[]
  concerts     Concert[]
  invoices     Invoice[]
  staffs       Staff[]
  vendor       Vendor?    


  @@index([role])
}

model EventReport {
  id              String   @id @default(uuid())
  organizerId     String
  authorId        String
  concertId       String?
  concertName     String?
  budgetAudit     Float    @default(0)
  marketingReach  Int      @default(0)
  staffEvaluation String?
  finalStatus     String   @default("SUCCESS")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  author          Staff    @relation(fields: [authorId], references: [id])

  @@index([organizerId])
  @@index([authorId])
}

model Concert {
  id           String        @id @default(uuid())
  organizerId  String
  name         String
  startDate    DateTime
  location     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  imageUrl     String?
  bookings     Booking[]
  organizer    User          @relation(fields: [organizerId], references: [id])
  organize     Organize?
  performances Performance[]
  staffs       Staff[]
  tickets      Ticket[]
  ticketPools  TicketPool[]

  @@index([organizerId])
  @@index([startDate])
}

model Artist {
  id           String        @id @default(uuid())
  name         String
  bio          String        @default("")
  contactInfo  String        @default("")
  createdAt    DateTime      @default(now())
  performances Performance[]

  @@index([name])
}

model Performance {
  id              String   @id @default(uuid())
  concertId       String
  artistId        String
  name            String
  durationMinutes Int
  startTime       DateTime
  artist          Artist   @relation(fields: [artistId], references: [id])
  concert         Concert  @relation(fields: [concertId], references: [id])

  @@index([concertId])
  @@index([artistId])
}

model Booking {
  id          String    @id @default(uuid())
  userId      String
  concertId   String
  totalAmount Float
  status      String
  createdAt   DateTime  @default(now())
  version     Int       @default(1)
  concert     Concert   @relation(fields: [concertId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  invoices    Invoice[]
  tickets     Ticket[]

  @@index([userId])
  @@index([concertId])
  @@index([status])
}

model TicketPool {
  id            String  @id @default(uuid())
  concertId     String
  ticketType    String
  price         Float
  totalQuantity Int     @default(0)
  soldCount     Int     @default(0)
  concert       Concert @relation(fields: [concertId], references: [id])

  @@unique([concertId, ticketType])
  @@index([concertId])
}

model Ticket {
  id         String   @id @default(uuid())
  bookingId  String?
  concertId  String
  userId     String?
  ticketType String
  price      Float
  version    Int      @default(1)
  booking    Booking? @relation(fields: [bookingId], references: [id])
  concert    Concert  @relation(fields: [concertId], references: [id])

  @@index([bookingId])
  @@index([concertId])
}

model Invoice {
  id             String        @id @default(uuid())
  bookingId      String
  userId         String
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  status         String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  paymentId      String?
  version        Int           @default(1)
  booking        Booking       @relation(fields: [bookingId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]

  @@index([bookingId])
  @@index([userId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  total       Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  bookingId     String
  amount        Float
  method        String
  status        String
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([bookingId])
  @@index([status])
}

model Location {
  id            String     @id @default(uuid())
  name          String
  address       String
  capacity      Int
  organizations Organize[]
}

model Organize {
  id         String      @id @default(uuid())
  concertId  String      @unique
  locationId String?
  equipments Divide[]
  logistics  Logistics[]
  concert    Concert     @relation(fields: [concertId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

model Divide {
  id            String         @id @default(uuid())
  organizeId    String
  name          String
  detail_divide DetailDivide[]
  organize      Organize       @relation(fields: [organizeId], references: [id])

  @@index([organizeId])
}

model DetailDivide {
  id       Int    @id @default(autoincrement())
  divideId String
  name     String
  divide   Divide @relation(fields: [divideId], references: [id])

  @@index([divideId])
}

model Logistics {
  id         String   @id @default(uuid())
  organizeId String
  taskName   String
  status     String
  cost       Float    @default(0)
  vendor     String   @default("")
  organize   Organize @relation(fields: [organizeId], references: [id])

  @@index([organizeId])
}

model Staff {
  id           String             @id @default(uuid())
  userId       String
  name         String
  role         String
  concertId    String?
  organizerId  String?
  managerId    String?
  bio          String?
  cvUrl        String?
  reports      EventReport[]
  jobPosts     JobPost[]          @relation("ManagerJobPosts")
  concert      Concert?           @relation(fields: [concertId], references: [id])
  manager      Staff?             @relation("StaffToManager", fields: [managerId], references: [id])
  reportsTo    Staff[]            @relation("StaffToManager")
  user         User               @relation(fields: [userId], references: [id])
  applications StaffApplication[] @relation("ApplicantStaff")
  tasks        StaffTask[]
  vendorId     String?
 vendor Vendor? @relation(fields: [vendorId], references: [id])           

  @@index([concertId])
  @@index([userId])
  @@index([organizerId])
  @@index([managerId])
}

model JobPost {
  id           String             @id @default(uuid())
  title        String
  description  String
  requirements String
  status       String             @default("OPEN")
  companyName  String?
  companyLogo  String?
  location     String?
  salary       String?
  organizerId  String
  category     String             @default("STAFF")
  authorId     String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  author       Staff              @relation("ManagerJobPosts", fields: [authorId], references: [id])
  applications StaffApplication[] @relation("JobApplications")

  @@index([organizerId])
  @@index([authorId])
  @@index([status])
}

model StaffApplication {
  id          String   @id @default(uuid())
  applicantId String
  cvUrl       String
  message     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobPostId   String
  applicant   Staff    @relation("ApplicantStaff", fields: [applicantId], references: [id])
  jobPost     JobPost  @relation("JobApplications", fields: [jobPostId], references: [id])

  @@index([applicantId])
  @@index([jobPostId])
  @@index([status])
}

model StaffInvitation {
  id          String   @id @default(uuid())
  email       String
  role        String
  organizerId String
  token       String   @unique
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  managerId   String?

  @@index([email])
  @@index([token])
}

model StaffTask {
  id          String   @id @default(uuid())
  staffId     String
  description String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Vendor {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  equipments  Equipment[]
  orders      LogisticsOrder[]
  staffs      Staff[]
}

model Equipment {
  id          String   @id @default(uuid())
  vendorId    String
  name        String
  category    String
  description String?
  totalQty    Int      @default(0)
  availableQty Int     @default(0)
  status      String   @default("AVAILABLE")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  logisticsItems LogisticsOrderItem[]

  @@index([vendorId])
  @@index([category])
}

model LogisticsOrder {
  id          String   @id @default(uuid())
  vendorId    String
  organizerId String
  eventId     String?
  status      String   @default("PENDING")
  notes       String?
  orderDate   DateTime @default(now())
  deliveryDate DateTime?
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  items       LogisticsOrderItem[]

  @@index([vendorId])
  @@index([status])
}

model LogisticsOrderItem {
  id          String   @id @default(uuid())
  orderId     String
  equipmentId String
  quantity    Int
  order       LogisticsOrder @relation(fields: [orderId], references: [id])
  equipment   Equipment      @relation(fields: [equipmentId], references: [id])

  @@index([orderId])
  @@index([equipmentId])
}
