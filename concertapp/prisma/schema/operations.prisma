// ─── OPERATIONS CONTEXT ──────────────────────────────────────────────────────
// Quản lý vận hành sự kiện: yêu cầu, địa điểm, khu vực, ca làm việc

model EventRequirement {
  id              String   @id @default(uuid())
  concertId       String
  authorId        String
  vendorId        String?
  title           String
  description     String?
  status          String   @default("PENDING")
  staffNeeded     Int      @default(0)
  equipmentNeeded Int      @default(0)
  budgetAllocated Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  concert         Concert  @relation(fields: [concertId], references: [id])
  author          Staff    @relation("RequirementAuthor", fields: [authorId], references: [id])
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])

  @@index([concertId])
  @@index([authorId])
  @@index([vendorId])
}

model Shift {
  id          String   @id @default(uuid())
  zoneId      String
  managerId   String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  headcount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  zone        Zone              @relation(fields: [zoneId], references: [id])
  manager     Staff?            @relation("ShiftManager", fields: [managerId], references: [id])
  assignments ShiftAssignment[]

  @@index([zoneId])
  @@index([managerId])
}

model ShiftAssignment {
  id        String    @id @default(uuid())
  shiftId   String
  staffId   String
  status    String    @default("ASSIGNED")
  checkIn   DateTime?
  checkOut  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shift     Shift     @relation(fields: [shiftId], references: [id])
  staff     Staff     @relation(fields: [staffId], references: [id])

  @@index([shiftId])
  @@index([staffId])
}

// ─── LEGACY ORGANIZE CONTEXT ─────────────────────────────────────────────────
// Cấu trúc tổ chức địa điểm (Organize, Location, Divide, DetailDivide, Logistics)

model Location {
  id            String     @id @default(uuid())
  name          String
  address       String
  capacity      Int
  organizations Organize[]
}

model Organize {
  id         String      @id @default(uuid())
  concertId  String      @unique
  locationId String?
  equipments Divide[]
  logistics  Logistics[]
  concert    Concert     @relation(fields: [concertId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

model Divide {
  id            String         @id @default(uuid())
  organizeId    String
  name          String
  detail_divide DetailDivide[]
  organize      Organize       @relation(fields: [organizeId], references: [id])

  @@index([organizeId])
}

model DetailDivide {
  id       Int    @id @default(autoincrement())
  divideId String
  name     String
  divide   Divide @relation(fields: [divideId], references: [id])

  @@index([divideId])
}

model Logistics {
  id         String   @id @default(uuid())
  organizeId String
  taskName   String
  status     String
  cost       Float    @default(0)
  vendor     String   @default("")
  organize   Organize @relation(fields: [organizeId], references: [id])

  @@index([organizeId])
}
